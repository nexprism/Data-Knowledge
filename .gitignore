# ==============================================================================
# Data Knowledge - Root .gitignore
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
**/node_modules/

# Environment Variables & Secrets (NEVER commit credentials)
.env
.env.*
*.env
!.env.example
!web/.env.production
!admin/.env.production
**/.env
**/.env.*
!web/.env.production
!admin/.env.production
config/firebase-service-account.json
**/firebase-service-account.json
*.pem
*.key
*.cert

# Production Build Outputs
dist/
dist-ssr/
build/
**/dist/
**/build/
.output/
.turbo/
.cache/

# Zip archives (dist.zip etc — kept locally for deployment, must not be watched by Vite)
*.zip
**/dist.zip

# Logs & Debugging
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# User Uploads & Generated Media / Invoices / PDFs
backend/uploads/*
!backend/uploads/.gitkeep
backend/uploads/**/*
!backend/uploads/**/.gitkeep
uploads/*
!uploads/.gitkeep
uploads/**/*
!uploads/**/.gitkeep
invoices/*.pdf
certificates/*.pdf

# Large Media
*.mp4
*.mov
*.avi
*.mkv
*.flv
*.wmv
*.mpg
*.mpeg
*.webm

# OS & Editor Files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local
